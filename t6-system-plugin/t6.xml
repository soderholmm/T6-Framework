<?xml version="1.0" encoding="utf-8"?>
<extension version="6.0" type="plugin" group="system" method="upgrade">
	<name>plg_system_t6</name>
	<version>3.0.0</version>
	<creationDate>March 22, 2026</creationDate>
	<author>Ab Söderholms IT-tjänster Oy - based on work by JoomlArt</author>
	<authorEmail>info@ittjanster.fi</authorEmail>
	<authorUrl>www.ittjanster.fi</authorUrl>
	<copyright>Copyright (C) 2005 - 2025 JoomlArt.com | Ab Söderholms IT-tjänster Oy</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<description><![CDATA[
			<div class="tpl-info">
				<h2>T6 Framework for Joomla 6</h2>
				<p>T6 Framework is powerful and advanced responsive template framework for Joomla. It is a modern, flexible and highly customizable framework to build beautiful Joomla websites easier.</p>
			</div>

			<style>
				.tpl-info { overflow: hidden; padding: 20px 0; }
				.tpl-info p { float: left; width: 60%;}
				.tpl-info .btn { box-shadow: 0 2px 10px 0 rgba(0,0,0,.16); border: 0; border-radius: 3px; float: right; min-height: 52px; padding: 0 24px; line-height: 52px; transition: all .2s cubic-bezier(.4,0,.2,1); }
				.tpl-info .btn span { margin-right: 12px;}
			</style>
		]]></description>
	<files>
		<filename plugin="t6">t6.php</filename>
		<folder>admin</folder>
		<folder>layouts</folder>
		<folder>src</folder>
		<folder>sql</folder>
		<folder>themes</folder>
		<folder>vendor</folder>
	</files>
	<autoload>
		<namespace path="src/t6">T6</namespace>
		<namespace path="admin/src">T6Admin</namespace>
	</autoload>
	<media folder="media" destination="t6">
		<folder>author</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="t6author_on"
					type="radio"
					default="1"
					label="Turn On T6 Author"
					description=""
					class="btn-group btn-group-yesno"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>
			</fieldset>
		</fields>
	</config>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.plg_system_t6.ini</language>
		<language tag="en-GB">en-GB/en-GB.plg_system_t6.sys.ini</language>
	</languages>
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<updateservers>
		
	</updateservers>
	<scriptfile>t6.scripts.php</scriptfile>
</extension>
  