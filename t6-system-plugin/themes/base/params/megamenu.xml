<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="megaRow" addfieldpath="/plugins/system/t6/admin/field">
		<fieldset name="row" label="T6_LAYOUT_TAB_GENERAL" description="T6_LAYOUT_SECTION_GENERAL_DESC">
			<!-- mega info -->
			<field name="mega-cols" class="t6-layout" class_field="mega-cols col-12" type="t6section" default="" label="T6_COLS_NUMBER" group="row" description="T6_COLS_NUMBER_DESC" />
		</fieldset>
	</fields>
	<fields name="megaCol" addfieldpath="/plugins/system/t6/admin/field">
		<fieldset name="col" label="T6_LAYOUT_TAB_GENERAL" description="T6_LAYOUT_SECTION_GENERAL_DESC">
			<!-- site info -->
			<field name="title" class="" class_field="title col-12" type="t6text" default="" label="T6_COL_TITLE" group="col" description="T6_COL_TITLE_DESC" />
			<field name="type" class="t6-layout" class_field="type col-12" functions="getItemType" type="t6list" default="" group="col" label="T6_COL_TYPE" description="T6_COL_TYPE_DESC" />
			<field name="module" class="t6-layout" class_field="module name_type col-12" functions="getModules" type="t6list" default="" group="col" label="T6_MODULE_TYPE" description="T6_MODULE_TYPE_DESC" />
			<field name="position" class="t6-layout" class_field="position name_type col-12" functions="getPositions" type="t6list" default=""  group="col" label="T6_POSITION_TYPE" description="T6_POSITION_TYPE_DESC" />
			<field name="items" class="t6-layout" class_field="items name_type col-12"  type="t6text" default="" group="col" label="T6_MENU_ITEM_TYPE" description="T6_MENU_ITEM_DESC" hint='0px 0px 0px 0px' />
			<field name="style" class="t6-layout" class_field="style  col-12" type="t6list" functions="getModuleStyle" default="" group="col" label="T6_MODULE_STYLE_NAME" description="T6_MODULE_STYLE_NAME_DESC" hint='extra class' />
			<field name="name" class="" hideLabel="hidden" class_field="name col-12" type="t6text" default="" group="col" label="T6_LAYOUT_NAME" description="T6_LAYOUT_NAME_DESC" />
		</fieldset>
	</fields>
</form>